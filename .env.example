# Food Verse AI - Environment Configuration Example
# Copy this file to .env and insert your real keys

# Google AI Studio Gemini API Key (Free Tier: 15 RPM, 1500 RPD)
# Get yours free at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# USDA FoodData Central API Key (Free: 1000 requests/hour)
# Get yours free at https://fdc.nal.usda.gov/api-key-signup.html
# Leave as DEMO_KEY for quick local testing (30 req/hr)
USDA_API_KEY=DEMO_KEY

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite Port
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
